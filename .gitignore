# Dependencies
node_modules/
.npm-cache/
# pnpm content-addressable store (created when running in sandbox mode)
.pnpm-store/
# Build output
dist/

# Local data & auth
store/
data/
logs/

# Groups - per-installation state, not tracked
groups/*
!groups/*/
groups/*/*

# Composer-managed CLAUDE.md/CODEX.md artifacts (regenerated every spawn) and
# per-group memory (CLAUDE.local.md/CODEX.local.md) must never be committed.
groups/*/CODEX.md
**/CLAUDE.local.md
**/CODEX.local.md
**/.claude-shared.md
**/.codex-shared.md
**/.claude-fragments/
**/.codex-fragments/

# Secrets
*.keys.json
.env
.env*

# Temp files
.tmp-*

# OS
.DS_Store

# IDE
.idea/
.vscode/

# Skills system (local per-installation state)
.nanoclaw/

agents-sdk-docs
